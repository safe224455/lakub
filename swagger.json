{
  "openapi": "3.0.0",
  "info": {
    "title": "Leave Management System API",
    "version": "1.0.0",
    "description": "API documentation for the Leave Management System"
  },
  "paths": {
    "/api/attendance/{id}": {
      "get": {
        "summary": "Get attendance by user ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "room_id": {
                            "type": "string"
                          },
                          "user_id": {
                            "type": "string"
                          },
                          "workplace": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    },
                    "status_code": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/attendance": {
      "post": {
        "summary": "Create attendance record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "room_id": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string"
                  },
                  "workplace": {
                    "type": "string"
                  }
                },
                "required": [
                  "room_id",
                  "user_id",
                  "workplace"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created attendance record"
          }
        }
      }
    },
    "/api/leave": {
      "get": {
        "summary": "Get leave requests",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID for authorization"
          }
        ],
        "responses": {
          "200": {
            "description": "List of leave requests"
          }
        }
      },
      "post": {
        "summary": "Create leave request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "dateFrom": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "dateTo": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "numberOfDays": {
                    "type": "number"
                  },
                  "leaveType": {
                    "type": "string",
                    "enum": [
                      "sick",
                      "personal",
                      "vacation",
                      "other"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "user_id",
                  "dateFrom",
                  "dateTo",
                  "numberOfDays",
                  "leaveType",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created leave request"
          }
        }
      }
    },
    "/api/room/{id}": {
      "get": {
        "summary": "Get room by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room details"
          }
        }
      },
      "put": {
        "summary": "Update room",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "room_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated room"
          }
        }
      },
      "delete": {
        "summary": "Delete room",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted room"
          }
        }
      }
    },
    "/api/room": {
      "get": {
        "summary": "Get all rooms",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of rooms"
          }
        }
      },
      "post": {
        "summary": "Create room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "room_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "room_name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created room"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Get user by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details"
          }
        }
      },
      "put": {
        "summary": "Update user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "roomCode": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated user"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users"
          }
        }
      },
      "post": {
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "fullname": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created user"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttendanceData": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "workplace": {
            "type": "string"
          }
        },
        "required": [
          "room_id",
          "user_id",
          "workplace"
        ]
      },
      "UserData": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "fullname": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "RoomData": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "room_name": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "room_name"
        ]
      }
    }
  }
}